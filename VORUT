local function groundInfo(hrp, hum)
 local params = RaycastParams.new()
 params.FilterType = Enum.RaycastFilterType.Exclude
 local ignore = {}
 if player.Character then ignore[#ignore + 1] = player.Character end
 for _, p in ipairs(floorParts) do
  ignore[#ignore + 1] = p
 end
 params.FilterDescendantsInstances = ignore
 local result = Workspace:Raycast(hrp.Position + Vector3.new(0, 5, 0), Vector3.new(0, -2000, 0), params)
 if result then
  local inst = result.Instance
  local color
  if inst and inst:IsA("Terrain") then
   local ok, c = pcall(function()
    return Workspace.Terrain:GetMaterialColor(result.Material)
   end)
   if ok then color = c end
  elseif inst and inst:IsA("BasePart") then
   color = inst.Color
  end
  if color then
   lastFloorColor = color
   lastFloorMaterial = result.Material
  end
  return result.Position.Y
 end
 return hrp.Position.Y - hum.HipHeight - hrp.Size.Y / 2
end
local function removeFloor()
 for _, p in ipairs(floorParts) do
  p:Destroy()
 end
 table.clear(floorParts)
 floorCenter = nil
end
local function placeFloor()
 local _, hum, hrp = parts()
 if not hrp then return end
 local y = groundInfo(hrp, hum)
 if #floorParts == 0 then
  for ix = -1, 1 do
   for iz = -1, 1 do
    local part = Instance.new("Part")
    part.Name = "SafeFloor"
    part.Anchored = true
    part.CanCollide = true
    part.CanQuery = false
    part.CanTouch = false
    part.CastShadow = false
    part.Size = Vector3.new(FLOOR_TILE, FLOOR_HEIGHT, FLOOR_TILE)
    part:SetAttribute("TileX", ix)
    part:SetAttribute("TileZ", iz)
    part.Parent = Workspace
    floorParts[#floorParts + 1] = part
   end
  end
 end
 local cx, cz = hrp.Position.X, hrp.Position.Z
 local top = y - FLOOR_HEIGHT / 2 + 0.05
 for _, part in ipairs(floorParts) do
  local ix = part:GetAttribute("TileX")
  local iz = part:GetAttribute("TileZ")
  part.Color = lastFloorColor or Color3.fromRGB(110, 110, 110)
  if lastFloorMaterial then
   pcall(function() part.Material = lastFloorMaterial end)
  end
  part.Transparency = state.floorTransparency
  part.CFrame = CFrame.new(cx + ix * FLOOR_TILE, top, cz + iz * FLOOR_TILE)
 end
 floorCenter = Vector3.new(cx, top, cz)
end
