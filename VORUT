local function rawStat(plr, key)
 local f = found[plr]
 if not f then return nil, nil end
 local k = normStr(key)
 local plain, level, pq, lq
 for _, slot in pairs(f.list) do
  for _, e in pairs(slot) do
   local sg = e.s
   local leaf = sg[#sg]
   local isVal, isLv = false, false
   if leaf == k or leaf == k .. "value" or leaf == k .. "amount" or leaf == "current" .. k then
    isVal = true
    for i = 1, #sg - 1 do
     if sg[i]:find("level", 1, true) or sg[i] == "lv" or sg[i] == "lvl" then
      isVal, isLv = false, true
     end
    end
   elseif leaf == k .. "level" or leaf == k .. "lv" or leaf == k .. "lvl" or leaf == "level" .. k or leaf == "lv" .. k or leaf == k .. "upgrade" or leaf == k .. "upgrades" then
    isLv = true
   else
    for i = 1, #sg - 1 do
     if sg[i] == k then
      if leaf == "value" or leaf == "amount" or leaf == "current" then
       isVal = true
      elseif leaf == "level" or leaf == "lv" or leaf == "lvl" then
       isLv = true
      end
     end
    end
   end
   if isVal or isLv then
    local n = readFound(e)
    if n then
     if isVal and (not pq or e.q < pq) then plain, pq = n, e.q end
     if isLv and (not lq or e.q < lq) then level, lq = n, e.q end
    end
   end
  end
 end
 return plain, level
end
local function resolveStat(key, plain, level, mode)
 local m = MECH[normStr(key)]
 if level then
  local value = plain
  if not value and m then value = m.value(level) end
  return value, level, true
 end
 if not plain then return nil, nil, true end
 if mode == "value" and m then
  local x = m.level(plain)
  local r = math.floor(x + 0.5)
  return plain, r, r >= 1 and math.abs(x - r) < 1e-6
 end
 if m then return m.value(plain), plain, true end
 return nil, plain, true
end
