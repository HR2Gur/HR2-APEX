section(function()
 local playerElements = {}
 local playerCards = {}
 local playersDirty = false
 local armedTarget, armedAt
 local function askTeleport(target)
  local name = target.DisplayName
  local ok = pcall(function()
   Window:Dialog({
    Title = "Teleport",
    Content = "Teleport to " .. name .. "?",
    Buttons = {
     {Title = "Cancel", Variant = "Secondary", Callback = function() end},
     {Title = "Teleport", Variant = "Primary", Callback = function() teleportToPlayer(target) end},
    },
   })
  end)
  if ok then return end
  if armedTarget == target and os.clock() - armedAt < 6 then
   armedTarget = nil
   teleportToPlayer(target)
  else
   armedTarget = target
   armedAt = os.clock()
   notify("Tap again to teleport to " .. name)
  end
 end
 local lastOrder = ""
 local function orderSig()
  local list = {}
  for _, p in ipairs(Players:GetPlayers()) do
   list[#list + 1] = {p = p, v = sizeOf(p)}
  end
  table.sort(list, function(a, b)
   if a.v ~= b.v then return a.v > b.v end
   return a.p.Name < b.p.Name
  end)
  local names = {}
  for i, e in ipairs(list) do
   if i > 60 then break end
   names[#names + 1] = e.p.Name
  end
  return table.concat(names, ",")
 end
 local function refreshPlayersUI()
  clearList(playerElements)
  table.clear(playerCards)
  local list = {}
  for _, p in ipairs(Players:GetPlayers()) do
   list[#list + 1] = p
  end
  table.sort(list, function(a, b)
   local sa, sb = sizeOf(a), sizeOf(b)
   if sa ~= sb then return sa > sb end
   return a.Name < b.Name
  end)
  lastOrder = orderSig()
  for i, p in ipairs(list) do
   if i > 60 then break end
   local buttons
   if p ~= player then
    buttons = {{Title = "Teleport", Callback = function() askTeleport(p) end}}
   end
   local el = playersTab:Paragraph({
    Title = "#" .. i .. "  " .. p.Name .. (p == player and " (you)" or ""),
    Desc = scoutDesc(p),
    Image = "rbxthumb://type=AvatarHeadShot&id=" .. p.UserId .. "&w=150&h=150",
    ImageSize = 44,
    Buttons = buttons,
   })
   playerElements[#playerElements + 1] = el
   playerCards[p] = el
  end
 end
 connect(Players.PlayerAdded, function() playersDirty = true end)
 connect(Players.PlayerRemoving, function() playersDirty = true end)
 loop(1, function()
  if not playersDirty and orderSig() ~= lastOrder then
   playersDirty = true
  end
  if playersDirty then
   playersDirty = false
   refreshPlayersUI()
  end
 end)
 loop(3, function()
  for p, el in pairs(playerCards) do
   if p.Parent then
    pcall(function()
     el.ParagraphFrame:SetDesc(scoutDesc(p))
    end)
   end
  end
 end)
 addSection(playersTab, "Everyone in this server")
 addButton(playersTab, "Refresh players", "Cards show role, MaxSize, EatSpeed, Multiplier and Speed with levels", refreshPlayersUI)
 refreshPlayersUI()
end)
