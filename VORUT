  local entries = {}
  for _, plr in ipairs(Players:GetPlayers()) do
   if not rows[plr] then createRow(plr) end
   table.insert(entries, {plr = plr, value = readStat(plr)})
  end
  table.sort(entries, function(a, b) return a.value > b.value end)
  for i, entry in ipairs(entries) do
   local r = rows[entry.plr]
   r.row.LayoutOrder = i
   r.rank = i
   r.value = entry.value
   local text = formatNumber(entry.value)
   if r.val.Text ~= text then r.val.Text = text end
  end
  for plr, r in pairs(rows) do
   if not plr.Parent then
    r.row:Destroy()
    rows[plr] = nil
   end
  end
  if card.Visible and cardPlayer and rows[cardPlayer] then
   cardRank.Text = "Rank #" .. rows[cardPlayer].rank
   cardSize.Text = formatNumber(rows[cardPlayer].value)
